{
  "name": "cozea",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/server",
    "packages/*",
    "packages/substrate-*"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "bun -e \"if(process.platform==='darwin'){const fs=require('fs');const path=require('path');for(const a of ['darwin-arm64','darwin-x64']){const p=path.join('node_modules','node-pty','prebuilds',a,'spawn-helper');try{if(fs.existsSync(p))fs.chmodSync(p,0o755)}catch{}}}\" && bun run scripts/apply-legend-list-patch.mjs && bun run scripts/apply-effect-rpc-jsonrpc-id-patch.mjs",
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:chrome-devtools": "unset ELECTRON_RUN_AS_NODE && ELECTRON_REMOTE_DEBUGGING_PORT=9222 electron-vite dev",
    "dev:perf:modern": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:perf:baseline": "unset ELECTRON_RUN_AS_NODE && VITE_FF_DATA_ROUTER=0 VITE_FF_VIEW_TRANSITIONS=0 VITE_FF_PRIORITIZED_SCHEDULING=0 VITE_FF_REACT_COMPILER=0 VITE_FF_ROLLDOWN_BUILD=0 VITE_FF_JANK_DIAGNOSTICS=0 VITE_FF_CONTENT_VISIBILITY=0 VITE_FF_OFFSCREEN_SCREENSHOT=0 VITE_FF_UTILITY_PROCESS_MANIFEST=0 electron-vite dev",
    "perf:runbook": "echo 'See docs/perf-runbook.md'",
    "perf:trace-summary": "bun run scripts/summarize-perf-trace.mjs",
    "perf:bundle-summary": "bun run scripts/summarize-renderer-bundles.mjs",
    "deploy": "bunx convex deploy",
    "build": "electron-vite build",
    "prepare:runtime-metadata": "bun run scripts/prepare-runtime-metadata.mjs",
    "sign:runtime-metadata": "bun run scripts/sign-runtime-metadata.mjs",
    "predist": "bun run prepare:runtime-metadata",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "dist:local": "CSC_IDENTITY_AUTO_DISCOVERY=false bun run dist -- --publish never",
    "release": "bun run dist -- --publish always",
    "snapshot:generate": "bun run scripts/generate-v8-snapshot.mjs",
    "build:snapshot": "bun run snapshot:generate && bun run build",
    "typecheck": "tsc --project tsconfig.app.json",
    "typecheck:assistant-runtime": "tsc --project tsconfig.assistant-runtime.json",
    "typecheck:electron": "tsc --project tsconfig.electron.json",
    "lint": "bunx --bun oxlint src electron convex shared tests electron.vite.config.ts vitest.config.ts",
    "test": "bunx vitest run",
    "models:sync": "bun run scripts/sync-model-picker.mjs",
    "check:effect-schema": "node scripts/check-effect-schema-standardization.mjs",
    "check:assistant-imports": "bunx vitest run tests/assistant/assistantChatRuntimeImports.test.ts",
    "audit:electron-ipc": "node scripts/audit-electron-ipc.mjs",
    "audit:electron-api-renderer": "node scripts/audit-electron-api-renderer.mjs",
    "spike:t3-server": "node scripts/spike-t3-server-boot.mjs",
    "smoke:t3-server": "bun scripts/smoke-t3-server.mjs",
    "vendor:sync-t3code-pin": "node scripts/vendor/sync-t3code-pin.mjs",
    "test:watch": "bunx vitest",
    "preview": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "fmt": "bunx --bun oxfmt -w .",
    "fmt:check": "bunx --bun oxfmt --check .",
    "perf:interactions": "node scripts/perf/interactions.mjs"
  },
