{
  "name": "cozea",
  "private": true,
  "version": "0.1.7",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "bun -e \"if(process.platform==='darwin'){const fs=require('fs');const path=require('path');for(const a of ['darwin-arm64','darwin-x64']){const p=path.join('node_modules','node-pty','prebuilds',a,'spawn-helper');try{if(fs.existsSync(p))fs.chmodSync(p,0o755)}catch{}}}\"",
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:perf:modern": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:perf:baseline": "unset ELECTRON_RUN_AS_NODE && VITE_FF_DATA_ROUTER=0 VITE_FF_VIEW_TRANSITIONS=0 VITE_FF_PRIORITIZED_SCHEDULING=0 VITE_FF_REACT_COMPILER=0 VITE_FF_ROLLDOWN_BUILD=0 VITE_FF_JANK_DIAGNOSTICS=0 VITE_FF_CONTENT_VISIBILITY=0 VITE_FF_OFFSCREEN_SCREENSHOT=0 VITE_FF_UTILITY_PROCESS_MANIFEST=0 electron-vite dev",
    "perf:runbook": "echo 'See docs/perf-runbook.md'",
    "dev:convex": "convex dev",
    "deploy": "convex deploy",
    "build": "electron-vite build",
    "prepare:bundled-runtimes": "bun run scripts/prepare-bundled-runtimes.mjs",
    "prepare:bundled-runtimes:check": "bun run scripts/prepare-bundled-runtimes.mjs --check",
    "prepare:bundled-runtimes:all": "bun run scripts/prepare-bundled-runtimes.mjs --all",
    "prepare:bundled-runtimes:check:all": "bun run scripts/prepare-bundled-runtimes.mjs --all --check",
    "prepare:runtime-pack-sources": "bun run scripts/prepare-runtime-pack-sources.mjs",
    "prepare:runtime-pack-sources:check": "bun run scripts/prepare-runtime-pack-sources.mjs --check",
    "prepare:runtime-pack-sources:all": "bun run scripts/prepare-runtime-pack-sources.mjs --all",
    "prepare:runtime-pack-sources:check:all": "bun run scripts/prepare-runtime-pack-sources.mjs --all --check",
    "build:runtime-packs": "bun run scripts/build-runtime-packs.mjs",
    "sign:runtime-manifest": "bun run scripts/sign-runtime-manifest.mjs",
    "predist": "bun run prepare:bundled-runtimes && bun run prepare:runtime-pack-sources && bun run build:runtime-packs",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "dist:local": "CSC_IDENTITY_AUTO_DISCOVERY=false bun run dist -- --publish never",
    "release": "bun run dist -- --publish always",
    "snapshot:generate": "bun run scripts/generate-v8-snapshot.mjs",
    "build:snapshot": "bun run snapshot:generate && bun run build",
    "typecheck": "tsc --project tsconfig.app.json",
    "typecheck:assistant-runtime": "tsc --project tsconfig.assistant-runtime.json",
    "lint": "oxlint src electron convex shared server/src server/scripts tests electron.vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "check:effect-schema": "node scripts/check-effect-schema-standardization.mjs",
    "check:assistant-imports": "vitest run tests/assistantChatRuntimeImports.test.ts",
    "audit:electron-ipc": "node scripts/audit-electron-ipc.mjs",
    "audit:electron-api-renderer": "node scripts/audit-electron-api-renderer.mjs",
    "test:watch": "vitest",
    "preview": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "fmt": "oxfmt -w .",
    "fmt:check": "oxfmt --check ."
  },
