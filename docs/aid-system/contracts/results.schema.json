{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozea.invalid/aid-design/1.1/results.schema.json",
  "title": "Protocol-neutral typed AID results — revision 1.1",
  "description": "No network resolution. Runtime provenance, ownership and evidence checks are additional requirements.",
  "oneOf": [
    {
      "$ref": "#/$defs/opened"
    },
    {
      "$ref": "#/$defs/execution"
    },
    {
      "$ref": "#/$defs/inspection"
    },
    {
      "$ref": "#/$defs/closing"
    },
    {
      "$ref": "#/$defs/described"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:~-]*$"
    },
    "counter": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "point"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "transformGeneration": {
          "$ref": "#/$defs/counter"
        },
        "units": {
          "enum": [
            "normalized",
            "image-pixels",
            "window-points",
            "display-points",
            "desktop-points"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "frameId",
        "transformGeneration",
        "units",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "units": {
                "const": "normalized"
              }
            }
          },
          "then": {
            "properties": {
              "x": {
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "$ref": "#/$defs/counter"
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "units": {
          "enum": [
            "normalized",
            "image-pixels",
            "window-points",
            "display-points",
            "desktop-points"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "toParent": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "generation",
        "units",
        "bounds",
        "toParent"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "AMBIGUOUS_TARGET",
            "BASE_EXPIRED",
            "CANCELLED",
            "CAPTURE_CAPACITY",
            "CHECKPOINT_EXPIRED",
            "CLEANUP_FAILED",
            "CONTROL_EXPIRED",
            "DEADLINE_EXCEEDED",
            "DELIVERY_UNCERTAIN",
            "DEPENDENCY_CHANGED",
            "DRIVER_LOST",
            "FOCUS_CHANGED",
            "INCOMPLETE_EVIDENCE",
            "INTERNAL",
            "INVALID_ARGUMENT",
            "NO_USABLE_WINDOW",
            "PREDICATE_BUDGET",
            "REQUEST_CONFLICT",
            "RESOURCE_EXPIRED",
            "RESOURCE_LIMIT",
            "RESOURCE_NOT_FOUND",
            "SEAT_BUSY",
            "STALE_TARGET",
            "UNAUTHORIZED",
            "UNQUALIFIED_CAPABILITY",
            "UNSAFE_CHECKPOINT",
            "UNSUPPORTED_CAPABILITY",
            "USER_TAKEOVER",
            "WORKSPACE_BUSY",
            "WORKSPACE_LOST"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "phase": {
          "enum": [
            "admission",
            "validation",
            "approach",
            "dispatch",
            "observation",
            "checkpoint",
            "cleanup",
            "transport",
            "guest"
          ]
        },
        "executionId": {
          "$ref": "#/$defs/id"
        },
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "submission": {
          "enum": [
            "not_submitted",
            "submitted",
            "submission_uncertain"
          ]
        },
        "canRetryAutomatically": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/json"
        }
      },
      "required": [
        "code",
        "message",
        "phase",
        "submission",
        "canRetryAutomatically"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "submission": {
                "enum": [
                  "submitted",
                  "submission_uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "canRetryAutomatically": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "executionId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "phase": {
          "enum": [
            "admission",
            "validation",
            "approach",
            "dispatch",
            "observation",
            "checkpoint",
            "cleanup",
            "transport",
            "guest"
          ]
        },
        "route": {
          "enum": [
            "foreground-event",
            "semantic-ax",
            "targeted-event",
            "sky",
            "window-control",
            "clipboard",
            "none"
          ]
        },
        "submission": {
          "enum": [
            "not_submitted",
            "submitted",
            "submission_uncertain"
          ]
        },
        "evidence": {
          "enum": [
            "not_checked",
            "change_observed",
            "no_change_observed",
            "inconclusive"
          ]
        },
        "outcome": {
          "enum": [
            "unverified",
            "verified",
            "failed"
          ]
        },
        "canRetryAutomatically": {
          "type": "boolean"
        },
        "target": {
          "type": "object",
          "properties": {
            "appId": {
              "$ref": "#/$defs/id"
            },
            "windowId": {
              "$ref": "#/$defs/id"
            },
            "elementId": {
              "$ref": "#/$defs/id"
            },
            "surfaceId": {
              "$ref": "#/$defs/id"
            },
            "generation": {
              "$ref": "#/$defs/counter"
            }
          },
          "required": [
            "generation"
          ],
          "additionalProperties": false
        },
        "after": {
          "$ref": "#/$defs/barrier"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "verification": {
          "type": "object",
          "properties": {
            "predicate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "evidenceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "predicate",
            "evidenceIds"
          ],
          "additionalProperties": false
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "timingsMs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "operationId",
        "executionId",
        "sequence",
        "phase",
        "route",
        "submission",
        "evidence",
        "outcome",
        "canRetryAutomatically",
        "after",
        "evidenceIds",
        "timingsMs",
        "warnings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "submission": {
                "enum": [
                  "submitted",
                  "submission_uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "canRetryAutomatically": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "verified",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "verification"
            ],
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "model-decision",
            "human-approval"
          ]
        },
        "executionId": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "schema": {
          "type": "object"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256
        },
        "dependencyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "kind",
        "executionId",
        "question",
        "schema",
        "evidenceIds",
        "dependencyDigest",
        "expiresAtMs"
      ],
      "additionalProperties": false
    },
    "nativeRequest": {
      "type": "object",
      "properties": {
        "apiRevision": {
          "const": "1.1"
        },
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/id"
        },
        "controlId": {
          "$ref": "#/$defs/id"
        },
        "controlEpoch": {
          "$ref": "#/$defs/counter"
        },
        "executionId": {
          "$ref": "#/$defs/id"
        },
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "apiRevision",
        "requestId",
        "runtimeGeneration",
        "controlId",
        "controlEpoch",
        "executionId",
        "operationId",
        "method",
        "arguments"
      ],
      "additionalProperties": false
    },
    "json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "barrier": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        }
      },
      "required": [
        "operationId",
        "sequence"
      ],
      "additionalProperties": false
    },
    "closeTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "execution"
            },
            "executionId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "executionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "control"
            },
            "controlId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "controlId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "workspaceId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/id"
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "pixelWidth": {
          "type": "integer",
          "minimum": 1
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1
        },
        "observationId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "id",
        "runtimeGeneration",
        "mimeType",
        "byteLength",
        "sha256",
        "expiresAtMs"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "pixelWidth": [
          "pixelHeight"
        ],
        "pixelHeight": [
          "pixelWidth"
        ]
      }
    },
    "emission": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 262144
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "data"
            },
            "value": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "image"
            },
            "artifact": {
              "$ref": "#/$defs/imageArtifact"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "observation"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          },
          "required": [
            "kind",
            "observation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "type": "boolean"
        },
        "qualified": {
          "type": "boolean"
        },
        "granted": {
          "type": "boolean"
        },
        "currentlyAvailable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/json"
        },
        "qualificationProfile": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "supported",
        "qualified",
        "granted",
        "currentlyAvailable"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "apiRevision": {
          "const": "1.1"
        },
        "contractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "types": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "apiRevision",
        "contractHash",
        "subject",
        "capabilities",
        "types",
        "examples",
        "limitations"
      ],
      "additionalProperties": false
    },
    "executionStatus": {
      "type": "object",
      "properties": {
        "executionId": {
          "$ref": "#/$defs/id"
        },
        "workspaceId": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting-for-condition",
            "waiting-for-model",
            "waiting-for-user",
            "paused",
            "stopping",
            "completed",
            "failed",
            "cancelled",
            "lost",
            "interrupted-after-possible-effect"
          ]
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "lastReceipt": {
          "$ref": "#/$defs/receipt"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "historyExpired": {
          "type": "boolean"
        },
        "droppedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "quiescent": {
          "type": "boolean"
        }
      },
      "required": [
        "executionId",
        "workspaceId",
        "state",
        "sequence",
        "historyExpired",
        "droppedRecords",
        "quiescent"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "waiting-for-model"
              }
            }
          },
          "then": {
            "required": [
              "checkpoint"
            ],
            "properties": {
              "checkpoint": {
                "properties": {
                  "kind": {
                    "const": "model-decision"
                  }
                }
              },
              "quiescent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "waiting-for-user"
              }
            }
          },
          "then": {
            "required": [
              "checkpoint"
            ],
            "properties": {
              "checkpoint": {
                "properties": {
                  "kind": {
                    "const": "human-approval"
                  }
                }
              },
              "quiescent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "lost",
                  "interrupted-after-possible-effect"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "checkpoint"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed",
                  "cancelled",
                  "paused"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quiescent": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "controlStatus": {
      "type": "object",
      "properties": {
        "controlId": {
          "$ref": "#/$defs/id"
        },
        "epoch": {
          "$ref": "#/$defs/counter"
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "revoking",
            "quiescent",
            "expired",
            "closed"
          ]
        },
        "mode": {
          "enum": [
            "visible-ui",
            "physical-ui",
            "hybrid"
          ]
        },
        "quiescent": {
          "type": "boolean"
        }
      },
      "required": [
        "controlId",
        "epoch",
        "state",
        "mode",
        "quiescent"
      ],
      "additionalProperties": false
    },
    "opened": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "opened"
        },
        "workspaceId": {
          "$ref": "#/$defs/id"
        },
        "control": {
          "$ref": "#/$defs/controlStatus"
        },
        "apiRevision": {
          "const": "1.1"
        },
        "contractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "workspaceId",
        "apiRevision",
        "contractHash"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "execution"
        },
        "status": {
          "$ref": "#/$defs/executionStatus"
        },
        "emissions": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/emission"
          }
        }
      },
      "required": [
        "kind",
        "status",
        "emissions"
      ],
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "inspection"
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionStatus"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
