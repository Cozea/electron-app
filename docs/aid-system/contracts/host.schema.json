{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozea.invalid/aid-design/1.1/host.schema.json",
  "title": "AID protocol-neutral host requests — design revision 1.1",
  "description": "Application contract, not an MCP protocol specification. Resolve refs locally. Authority, canonical byte limits and generation checks are additional native requirements.",
  "oneOf": [
    { "$ref": "#/$defs/open" }, { "$ref": "#/$defs/exec" },
    { "$ref": "#/$defs/inspect" }, { "$ref": "#/$defs/respond" },
    { "$ref": "#/$defs/close" }, { "$ref": "#/$defs/describe" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:~-]*$" },
    "key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:~-]+$" },
    "counter": { "type": "string", "maxLength": 20, "pattern": "^(0|[1-9][0-9]*)$" },
    "revision": { "const": "1.1" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "mode": { "enum": ["visible-ui", "physical-ui", "hybrid"] },
    "json": { "oneOf": [ { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" }, { "type": "array", "items": { "$ref": "#/$defs/json" } }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } } ] },
    "app": {
      "oneOf": [
        { "type": "object", "required": ["bundleId"], "properties": { "bundleId": { "type": "string", "minLength": 1, "maxLength": 512 } }, "additionalProperties": false },
        { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 512 } }, "additionalProperties": false },
        { "type": "object", "required": ["pid", "launchIdentity"], "properties": { "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "launchIdentity": { "type": "string", "minLength": 1, "maxLength": 256 } }, "additionalProperties": false }
      ]
    },
    "controlRequest": {
      "type": "object", "required": ["mode", "targetApps", "capabilities"], "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "targetApps": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/app" } },
        "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "requestedLeaseMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "wallMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "memoryMiB": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "pendingCalls": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "source": {
      "oneOf": [
        { "type": "object", "required": ["kind", "text"], "additionalProperties": false, "properties": { "kind": { "const": "text" }, "text": { "type": "string", "maxLength": 262144 } } },
        { "type": "object", "required": ["kind", "artifactId", "sha256"], "additionalProperties": false, "properties": { "kind": { "const": "artifact" }, "artifactId": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/hash" } } }
      ]
    },
    "open": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": {
        "method": { "const": "open" },
        "params": { "type": "object", "required": ["apiRevision", "idempotencyKey", "workspaceName"], "additionalProperties": false,
          "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "idempotencyKey": { "$ref": "#/$defs/key" }, "workspaceName": { "$ref": "#/$defs/name" }, "reuse": { "type": "boolean" }, "control": { "$ref": "#/$defs/controlRequest" } }
        }
      }
    },
    "exec": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": {
        "method": { "const": "exec" },
        "params": { "type": "object", "required": ["apiRevision", "workspaceId", "idempotencyKey", "cellName", "source"], "additionalProperties": false,
          "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "workspaceId": { "$ref": "#/$defs/id" }, "controlId": { "$ref": "#/$defs/id" }, "idempotencyKey": { "$ref": "#/$defs/key" }, "cellName": { "$ref": "#/$defs/name" }, "source": { "$ref": "#/$defs/source" }, "requestedBudget": { "$ref": "#/$defs/budget" } }
        }
      }
    },
    "inspect": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": {
        "method": { "const": "inspect" },
        "params": { "type": "object", "required": ["apiRevision", "workspaceId"], "additionalProperties": false,
          "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "workspaceId": { "$ref": "#/$defs/id" }, "executionId": { "$ref": "#/$defs/id" }, "sinceSequence": { "$ref": "#/$defs/counter" }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } }
        }
      }
    },
    "respond": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": {
        "method": { "const": "respond" },
        "params": { "type": "object", "required": ["apiRevision", "workspaceId", "executionId", "checkpointId", "idempotencyKey", "answer"], "additionalProperties": false,
          "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "workspaceId": { "$ref": "#/$defs/id" }, "executionId": { "$ref": "#/$defs/id" }, "checkpointId": { "$ref": "#/$defs/id" }, "idempotencyKey": { "$ref": "#/$defs/key" }, "answer": { "$ref": "#/$defs/json" } }
        }
      }
    },
    "closeTarget": {
      "oneOf": [
        { "type": "object", "required": ["kind", "executionId"], "additionalProperties": false, "properties": { "kind": { "const": "execution" }, "executionId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "required": ["kind", "controlId"], "additionalProperties": false, "properties": { "kind": { "const": "control" }, "controlId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "required": ["kind", "workspaceId"], "additionalProperties": false, "properties": { "kind": { "const": "workspace" }, "workspaceId": { "$ref": "#/$defs/id" } } }
      ]
    },
    "close": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": { "method": { "const": "close" }, "params": { "type": "object", "required": ["apiRevision", "target"], "additionalProperties": false, "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "target": { "$ref": "#/$defs/closeTarget" } } } }
    },
    "describe": {
      "type": "object", "required": ["method", "params"], "additionalProperties": false,
      "properties": { "method": { "const": "describe" }, "params": { "type": "object", "required": ["apiRevision", "subject"], "additionalProperties": false, "properties": { "apiRevision": { "$ref": "#/$defs/revision" }, "subject": { "type": "string", "minLength": 1, "maxLength": 256 }, "workspaceId": { "$ref": "#/$defs/id" } } } }
    }
  }
}
