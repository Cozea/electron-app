# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Auth Server / device gateway (optional override)
# NOTE: this one is read from the real process environment when the Vite config
# is evaluated, NOT from this file — electron.vite.config.ts does not load .env.
# Setting it here has no effect on the device gateway. Export it in your shell
# instead, e.g. `VITE_AUTH_SERVER_URL=https://... bun run dev`. When unset it
# falls back to the shared collab worker origin.
# VITE_AUTH_SERVER_URL=http://localhost:3001

# AI Gateway (optional override)
# In local dev, app code defaults to http://localhost:3001/ai/chat.
# VITE_AI_API_URL=http://localhost:3001/ai/chat
# Optional for Electron local AI runtime:
# - defaults to local AI SDK execution when unset
AI_LOCAL_RUNTIME_ENABLED=1
# - override base URL used to fetch managed provider envelopes
# COZEA_AI_API_URL=http://localhost:3001/ai
# Optional: enable local MCP-backed tool execution in Electron (default on)
COZEA_LOCAL_MCP_ENABLED=1
VITE_COLLAB_TRANSPORT=ws

# Substrate spine (default on — set to 0 to opt out)
# COZEA_SUBSTRATE_SHADOW_SERVER=0
# COZEA_SUBSTRATE_RPC_CHAT=0
# COZEA_SUBSTRATE_PROVIDERS=0
# COZEA_SUBSTRATE_VCS=0
# COZEA_SUBSTRATE_PRIMARY=0
# COZEA_OBS_NDJSON=0

# Substrate observability — OTLP HTTP logs export (default: http://127.0.0.1:4318/v1/logs)
# COZEA_OTLP_ENDPOINT=https://your-collector.example/v1/logs
# COZEA_OTLP_ENDPOINT=0
# COZEA_OBS_NDJSON_PATH=/tmp/cozea-substrate-obs.ndjson

# Stripe (for embedded checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AI wallet included balances (USD cents per month)
AI_WALLET_INCLUDED_PRO_MONTHLY_CENTS=1500
AI_WALLET_INCLUDED_MAX_MONTHLY_CENTS=4000
AI_WALLET_INCLUDED_STARTUP_CENTS=3000
AI_WALLET_INCLUDED_ENTERPRISE_CENTS=10000
