# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Auth Server (optional override)
VITE_AUTH_SERVER_URL=https://api.cozea.app

# AI Gateway (optional override)
# In local dev, app code defaults to http://localhost:3001/ai/chat.
VITE_AI_API_URL=https://api.cozea.app/ai/chat
VITE_COLLAB_TRANSPORT=ws

# Stripe (for embedded checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AI wallet included balances (USD cents per month)
AI_WALLET_INCLUDED_PRO_MONTHLY_CENTS=1500
AI_WALLET_INCLUDED_MAX_MONTHLY_CENTS=4000
AI_WALLET_INCLUDED_STARTUP_CENTS=3000
AI_WALLET_INCLUDED_ENTERPRISE_CENTS=10000
