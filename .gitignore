# Local working directories — kept on disk, never published.
# .agent/CONTINUITY.md is the agent continuity file required by AGENTS.md; it is
# per-workspace state, not source. research/ and scratch/ are investigation scratch.
.agent/
research/
scratch/

# Agent/skill tool output. Regenerated on demand, large, and never source:
# graphify knowledge graphs run to megabytes and are written wherever the tool
# is invoked, so match at any depth.
graphify-out/
**/graphify-out/
# Scan scoping for the same tool; local, like the graph it produces.
.graphifyignore
.impeccable/
**/.impeccable/

# Presentation decks. Investor material is drafted in .agent/ but exports land
# at the repo root, outside that rule — and this repository is public.
*.pptx
*.pptx.inspect.ndjson
