{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "noEmit": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@cozea/assistant-contracts": ["../../shared/assistant-contracts/index.ts"],
      "@cozea/assistant-contracts/*": ["../../shared/assistant-contracts/*"],
      "@cozea/assistant-shared/*": ["../../shared/assistant-shared/*"],
      "@cozea/effect-acp": ["../../packages/effect-acp/src/client.ts"],
      "@cozea/effect-acp/*": ["../../packages/effect-acp/src/*"],
      "@/features/projects/components/assistant": ["./src/features/assistant"],
      "@/features/projects/components/assistant/*": ["./src/features/assistant/*"],
      "@/features/projects/components/workbench": ["./src/features/workbench"],
      "@/features/projects/components/workbench/*": ["./src/features/workbench/*"],
      "@/features/projects/components/command-palette": ["./src/features/workbench/command-palette"],
      "@/features/projects/components/command-palette/*": ["./src/features/workbench/command-palette/*"],
      "@/*": ["./src/*"],
      "@shared/*": ["../../shared/*"],
      "@cozea/contracts": ["../../packages/contracts/src/index.ts"],
      "@cozea/contracts/*": ["../../packages/contracts/src/*"],
      "@cozea/client-runtime": ["../../packages/client-runtime/src/index.ts"],
      "@cozea/client-runtime/*": ["../../packages/client-runtime/src/*"],
      "@cozea/substrate-contracts": ["../../packages/substrate-contracts/src/index.ts"],
      "@cozea/substrate-client-runtime": ["../../packages/substrate-client-runtime/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["convex"]
}
