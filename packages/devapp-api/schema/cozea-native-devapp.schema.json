{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cozea.dev/schemas/cozea-native-devapp.schema.json",
  "title": "Cozea native React DevApp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "engines",
    "contributes"
  ],
  "properties": {
    "manifestVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cozea",
        "nativeApi"
      ],
      "properties": {
        "cozea": {
          "type": "string",
          "minLength": 1
        },
        "nativeApi": {
          "const": 1
        }
      }
    },
    "rendererModules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "output"
        ],
        "properties": {
          "entry": {
            "$ref": "#/$defs/packagePath"
          },
          "output": {
            "$ref": "#/$defs/packagePath"
          },
          "styles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "output"
            ],
            "properties": {
              "entry": {
                "$ref": "#/$defs/packagePath"
              },
              "output": {
                "$ref": "#/$defs/packagePath"
              }
            }
          }
        }
      }
    },
    "webApplications": {
      "type": "object"
    },
    "extension": {
      "type": "object"
    },
    "services": {
      "type": "object"
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "renderer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "default": {
                "type": "boolean"
              },
              "renderer": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "module",
                      "component"
                    ],
                    "properties": {
                      "kind": {
                        "const": "native-react"
                      },
                      "module": {
                        "type": "string"
                      },
                      "component": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Za-z0-9_$]{0,127}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "application"
                    ],
                    "properties": {
                      "kind": {
                        "const": "web-app"
                      },
                      "application": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "placement": {
                "type": "object"
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 128
        },
        "skills": {
          "type": "array",
          "maxItems": 64
        }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
