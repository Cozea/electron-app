{
  "name": "@cozea/devapp-api",
  "version": "0.1.0",
  "description": "Typed native renderer, extension-host, worker, manifest, and UI contracts for Cozea DevApps.",
  "keywords": [
    "cozea",
    "devapp",
    "electron",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cozea/electron-app.git",
    "directory": "packages/devapp-api"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./schema": "./schema/cozea-devapp.schema.json",
    "./schema/v3": "./schema/cozea-devapp-v3.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/native.ts src/ui.ts src/extension.ts src/manifest.ts --outdir dist --format esm --target browser --external react --external react-dom --external react/jsx-runtime && bunx tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  }
}
